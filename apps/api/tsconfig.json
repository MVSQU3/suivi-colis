{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2021", "outDir": "./dist", "rootDir": "./src",
    "strict": true, "esModuleInterop": true, "emitDecoratorMetadata": true, "experimentalDecorators": true,
    "skipLibCheck": true, "sourceMap": true, "strictPropertyInitialization": false
  },
  "include": ["src"]
}
