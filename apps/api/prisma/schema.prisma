generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  AGENT
}

enum ModeTransport {
  MER
  AIR
}

enum StatutCheckpoint {
  RECU_ENTREPOT_CHINE
  CHARGE_DANS_LOT
  PARTI_DE_CHINE
  ARRIVE_DESTINATION
  EN_DEDOUANEMENT
  DISPONIBLE_AU_RETRAIT
  REMIS_AU_CLIENT
  EXCEPTION
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  phone        String?
  primaryColor String?  @default("#F77F00")
  /// Pays du transitaire (ISO 3166-1 alpha-2) : pays par defaut des numeros saisis sans indicatif.
  paysCode     String   @default("CI")
  /// Devise d'affichage (ISO 4217)
  devise       String   @default("XOF")
  /// Fuseau IANA des dates affichees (stockage toujours en UTC)
  fuseau       String   @default("Africa/Abidjan")
  /// Langue de l'interface client (seul « fr » est traduit pour l'instant)
  langue       String   @default("fr")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]
  clients      Client[]
  lots         Lot[]
  colis        Colis[]
  sites        Site[]
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  email        String    @unique
  passwordHash String
  fullName     String
  role         UserRole
  isActive     Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
}

model Client {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  fullName  String
  phone     String
  email     String?
  city      String?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  colis     Colis[]
  liensAcces LienAcces[]
  sessions  SessionClient[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Lot {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  reference    String
  mode         ModeTransport
  departPrevu  DateTime?
  clotureLe    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  affectations AffectationLot[]
  checkpoints  Checkpoint[]

  @@unique([tenantId, reference])
  @@index([tenantId])
}

model Colis {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  clientId     String
  client       Client           @relation(fields: [clientId], references: [id])
  trackingCode String           @unique
  description  String
  cartons      Int              @default(1)
  poidsKg      Float?
  archivedAt   DateTime?
  mode         ModeTransport
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  affectations AffectationLot[]
  checkpoints  Checkpoint[]

  @@index([tenantId])
}

/// Période d'appartenance d'un colis à un lot : [debut, fin[ ; fin null = affectation ouverte.
/// Index unique partiel (une seule affectation ouverte par colis) ajouté en SQL dans la migration.
model AffectationLot {
  id       String    @id @default(cuid())
  tenantId String
  colisId  String
  colis    Colis     @relation(fields: [colisId], references: [id])
  lotId    String
  lot      Lot       @relation(fields: [lotId], references: [id])
  debut    DateTime
  fin      DateTime?

  @@index([tenantId])
  @@index([colisId])
  @@index([lotId])
}

/// Checkpoint append-only : cible soit un lot (lotId), soit un colis (colisId).
model Checkpoint {
  id          String           @id @default(cuid())
  tenantId    String
  lotId       String?
  lot         Lot?             @relation(fields: [lotId], references: [id])
  colisId     String?
  colis       Colis?           @relation(fields: [colisId], references: [id])
  statut      StatutCheckpoint
  lieu        String
  commentaire String?
  date        DateTime
  siteId      String?
  site        Site?            @relation(fields: [siteId], references: [id])
  createdById String?
  createdAt   DateTime         @default(now())

  @@index([tenantId])
  @@index([lotId, date])
  @@index([colisId, date])
}

/// Lieu public choisi par le transitaire ; seul lieu expose sur la page de suivi.
/// Unicite insensible a la casse par tenant : index SQL brut sur lower(nom) dans la migration.
model Site {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  nom         String
  actif       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  checkpoints Checkpoint[]

  @@index([tenantId])
}

/// Lien magique a usage unique (jeton stocke hache SHA-256), consomme uniquement par POST.
model LienAcces {
  id        String    @id @default(cuid())
  tenantId  String
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId])
}

/// Session client (cookie httpOnly), jeton hache, revocable.
model SessionClient {
  id         String    @id @default(cuid())
  tenantId   String
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([clientId])
}