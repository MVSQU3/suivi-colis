# Copié vers apps/api/.env par `pnpm env:setup` (secrets générés, DATABASE_URL lue depuis .db-url.local)
DATABASE_URL="postgresql://suivicolis:CHANGE_ME@127.0.0.1:5432/suivicolis?schema=public"
API_PORT=4000
APP_NAME="suivi-colis"
WEB_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
JWT_ACCESS_SECRET="CHANGE_ME_long_random"
JWT_REFRESH_SECRET="CHANGE_ME_other_long_random"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
TRACKING_RATE_LIMIT_PER_MIN=30
MAIL_TRANSPORT="console"
MAIL_FROM="Suivi Colis <no-reply@suivi-colis.local>"
SEED_ADMIN_PASSWORD="CHANGE_ME"
SEED_USER_PASSWORD="CHANGE_ME"

# Adresse publique du site (liens magiques envoyes aux clients) : https://<domaine> en production
PUBLIC_SITE_URL=http://localhost:3000
